# ==============================================================================
# ATHAR (أثر) - Environment Variables Configuration Template
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Site Deployment & Public URLs
# ------------------------------------------------------------------------------
# The canonical public URL of your production or staging deployment (without trailing slash)
NEXT_PUBLIC_SITE_URL=https://athar-magazine.vercel.app

# ------------------------------------------------------------------------------
# 2. Supabase Backend Credentials
# ------------------------------------------------------------------------------
# Your Supabase Project URL from app.supabase.com
NEXT_PUBLIC_SUPABASE_URL=

# Your Supabase Anon Key (Public)
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# (Optional Server Only) Supabase Service Role Key (NEVER expose to client code)
SUPABASE_SERVICE_ROLE_KEY=

# ------------------------------------------------------------------------------
# 3. Cloudflare R2 Media & File Storage (Optional for external assets)
# ------------------------------------------------------------------------------
# Cloudflare R2 Bucket Name for high-res documentary photography and assets
R2_BUCKET_NAME=
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
NEXT_PUBLIC_R2_PUBLIC_DOMAIN=

# ------------------------------------------------------------------------------
# 4. Google Analytics & Search Console
# ------------------------------------------------------------------------------
# Google Analytics 4 Measurement ID (e.g., G-XXXXXXXXXX)
NEXT_PUBLIC_GA_ID=

# Google Search Console HTML Verification Meta Tag content (optional)
NEXT_PUBLIC_GSC_VERIFICATION=

# ------------------------------------------------------------------------------
# 5. Google AdSense (Ready for monetization toggle)
# ------------------------------------------------------------------------------
# Set to 'true' to activate live AdSense placements across the platform
NEXT_PUBLIC_ENABLE_ADS=false

# Your Google AdSense Publisher ID (e.g., ca-pub-XXXXXXXXXXXXXXXX)
NEXT_PUBLIC_ADSENSE_CLIENT_ID=

# Specific ad slot IDs generated from your AdSense console
NEXT_PUBLIC_AD_SLOT_HEADER=
NEXT_PUBLIC_AD_SLOT_IN_ARTICLE=
NEXT_PUBLIC_AD_SLOT_SIDEBAR=
NEXT_PUBLIC_AD_SLOT_FOOTER=

# ------------------------------------------------------------------------------
# 6. Newsletter Integration (Optional - Defaults to local simulation)
# ------------------------------------------------------------------------------
# If using Resend for transactional newsletters:
RESEND_API_KEY=
RESEND_AUDIENCE_ID=
